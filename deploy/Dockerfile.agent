FROM python:3.11-slim

WORKDIR /app

COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/ ./backend/
ENV PYTHONPATH=/app/backend

# AGENT_SERVICE: intake | parsing | geospatial | policy | pipeline
ENV AGENT_SERVICE=pipeline
EXPOSE 8000

CMD ["sh", "-c", "adk web backend/spin_agents --port 8000"]
