# ─────────────────────────────────────────────────────────
# SPIN Frontend — Environment Variables
#
# Copy this file to .env.local for local development.
# For production, set these as environment variables in your
# hosting platform (Vercel / Netlify / Cloud Run build args).
# ─────────────────────────────────────────────────────────

# URL of the SPIN FastAPI backend
# Local dev:      http://localhost:8080
# Cloud Run:      https://spin-api-xxxx-as.a.run.app
VITE_API_URL=http://localhost:8080

# Google Maps JavaScript API key
# Required for the live intelligence dashboard heatmap.
# Without this key the map will not load — the rest of the
# site (landing, storytelling sections) works without it.
# Get a key at: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_MAPS_API_KEY=
