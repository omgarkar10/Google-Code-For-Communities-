{
  "version": 2,
  "builds": [
    {
      "src": "frontend/dashboard/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/assets/(.*)",
      "headers": { "cache-control": "public, max-age=31536000, immutable" },
      "dest": "/assets/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "env": {
    "VITE_API_URL": "@spin_api_url",
    "VITE_GOOGLE_MAPS_API_KEY": "@spin_maps_key"
  }
}
